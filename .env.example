# Local settings are created automatically by pnpm dev.
NARADA_MODE=local
PORT=3001
WEB_PORT=5173
AWS_REGION=us-east-1
DYNAMODB_ENDPOINT=http://127.0.0.1:8000
SQS_ENDPOINT=http://127.0.0.1:9324
APP_TABLE=narada-local-app
AUTH_TABLE=narada-local-auth
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
BETTER_AUTH_URL=http://localhost:5173
# At least 32 random bytes; automatically generated into .env.local.
BETTER_AUTH_SECRET=

# Optional local image library directory (defaults to .local/media).
# AWS deployments inject MEDIA_BUCKET; CloudFront serves /media/* from that private bucket.
MEDIA_DIRECTORY=.local/media

# Custom publication hosting (CDK supplies these in AWS; local mode stays disabled).
# PUBLICATION_SITE_ORIGIN=https://example.execute-api.ap-southeast-2.amazonaws.com
# PUBLICATION_SITE_FUNCTION_ARN=arn:aws:cloudfront::123456789012:function/publication-host
# PUBLICATION_DOMAIN_ACCOUNT=123456789012
# PUBLICATION_DOMAIN_ENVIRONMENT=staging
PUBLICATION_DOMAIN_LIMIT=5
