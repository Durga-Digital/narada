{
  "name": "@narada/worker",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "exports": {
    "./handlers": {
      "development": "./src/handlers.ts",
      "types": "./dist/handlers.d.ts",
      "default": "./dist/handlers.js"
    },
    "./lambda": {
      "development": "./src/lambda.ts",
      "types": "./dist/lambda.d.ts",
      "default": "./dist/lambda.js"
    },
    "./local": {
      "development": "./src/local.ts",
      "types": "./dist/local.d.ts",
      "default": "./dist/local.js"
    },
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./standalone": {
      "development": "./src/standalone.ts",
      "types": "./dist/standalone.d.ts",
      "default": "./dist/standalone.js"
    },
    "./runner": {
      "development": "./src/runner.ts",
      "types": "./dist/runner.d.ts",
      "default": "./dist/runner.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "tsx --conditions=development watch src/local.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/standalone.js"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.1149.0",
    "@narada/core": "workspace:*",
    "@narada/runtime-aws": "workspace:*",
    "dotenv": "18.0.7",
    "zod": "4.6.5",
    "@types/aws-lambda": "8.10.164"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "7.0.2"
  },
  "publishConfig": {
    "exports": {
      "./handlers": {
        "types": "./dist/handlers.d.ts",
        "default": "./dist/handlers.js"
      },
      "./lambda": {
        "types": "./dist/lambda.d.ts",
        "default": "./dist/lambda.js"
      },
      "./local": {
        "types": "./dist/local.d.ts",
        "default": "./dist/local.js"
      },
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./standalone": {
        "types": "./dist/standalone.d.ts",
        "default": "./dist/standalone.js"
      },
      "./runner": {
        "types": "./dist/runner.d.ts",
        "default": "./dist/runner.js"
      }
    }
  }
}
