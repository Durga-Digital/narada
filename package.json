{
  "name": "narada",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx --conditions=development scripts/dev.ts",
    "dev:seed": "tsx --conditions=development scripts/seed.ts",
    "dev:doctor": "tsx --conditions=development scripts/doctor.ts",
    "dev:down": "docker compose stop",
    "dev:reset": "tsx --conditions=development scripts/reset.ts",
    "oauth:feasibility": "tsx --conditions=development scripts/oauth-feasibility.ts",
    "oauth:clients": "tsx --conditions=development scripts/oauth-client-compatibility.ts",
    "test:oauth": "vitest run --project integration tests/integration/oauth-feasibility.test.ts",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "test:profile": "tsx --conditions=development scripts/test-profile.ts",
    "test:backend:browser": "tsx --conditions=development scripts/test-backend-browser.ts",
    "typecheck": "tsc --noEmit",
    "build": "pnpm --filter @narada/web build",
    "sdk:build": "pnpm --filter @durgadigital/narada build",
    "check": "pnpm backend:build && pnpm contracts:check && pnpm typecheck && pnpm test && pnpm sdk:build && pnpm build",
    "infra:synth": "tsx --conditions=development infrastructure/bin.ts",
    "infra:check": "pnpm infra:synth && tsx --conditions=development scripts/check-infra.ts",
    "deploy": "tsx --conditions=development scripts/deploy.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deploy:smoke": "tsx --conditions=development scripts/smoke-deployment.ts",
    "messages:purge-content": "tsx --conditions=development scripts/purge-message-content.ts",
    "sdk:check": "pnpm sdk:build && tsx --conditions=development scripts/check-sdk-package.ts",
    "contracts:generate": "tsx --conditions=development scripts/sync-contract-types.ts && tsx --conditions=development scripts/generate-operation-schemas.ts",
    "contracts:check": "tsx --conditions=development scripts/sync-contract-types.ts --check && tsx --conditions=development scripts/generate-operation-schemas.ts --check",
    "test:mcp": "vitest run --project integration tests/integration/mcp-production.test.ts",
    "mcp:clients": "NARADA_TEST_PRODUCTION_MCP=1 tsx --conditions=development scripts/oauth-client-compatibility.ts",
    "mcp:staging": "tsx --conditions=development scripts/verify-hosted-mcp.ts --stage staging",
    "mcp:production": "tsx --conditions=development scripts/verify-hosted-mcp.ts --stage production",
    "test:contracts": "vitest run --project unit tests/unit/operation-contracts.test.ts tests/unit/mcp-contracts.test.ts tests/unit/transport-parity.test.ts tests/unit/owner-security.test.ts",
    "contracts:verify": "pnpm contracts:check && pnpm typecheck && pnpm test:contracts && pnpm sdk:check",
    "backend:build": "pnpm --filter @narada/contracts build && pnpm --filter @narada/core build && pnpm --filter @narada/runtime-aws build && pnpm --filter @narada/mcp build && pnpm --filter @narada/http-api build && pnpm --filter @narada/api build && pnpm --filter @narada/worker build",
    "backend:check": "pnpm backend:build && tsx --conditions=development scripts/check-backend-packages.ts"
  },
  "dependencies": {
    "@aws-sdk/client-acm": "3.1149.0",
    "@aws-sdk/client-cloudfront": "3.1149.0",
    "@aws-sdk/client-dynamodb": "3.1149.0",
    "@aws-sdk/client-lambda": "3.1149.0",
    "@aws-sdk/client-s3": "3.1149.0",
    "@aws-sdk/client-sesv2": "3.1149.0",
    "@aws-sdk/client-sqs": "3.1149.0",
    "@aws-sdk/client-ssm": "3.1149.0",
    "@aws-sdk/client-sts": "3.1149.0",
    "@aws-sdk/credential-providers": "3.1149.0",
    "@aws-sdk/lib-dynamodb": "3.1149.0",
    "@better-auth/core": "1.7.7",
    "@better-auth/mcp": "1.7.7",
    "@better-auth/oauth-provider": "1.7.7",
    "@datar-platform/better-auth-dynamodb": "0.2.2",
    "@hono/node-server": "2.1.4",
    "@modelcontextprotocol/server": "2.3.1",
    "@radix-ui/react-slot": "1.4.0",
    "@tailwindcss/vite": "4.3.3",
    "aws-cdk-lib": "2.273.0",
    "better-auth": "1.7.7",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "constructs": "10.8.1",
    "csv-parse": "7.0.3",
    "dotenv": "18.0.7",
    "hono": "4.13.13",
    "ipaddr.js": "2.2.0",
    "lucide-react": "1.54.0",
    "nodemailer": "10.0.16",
    "parse5": "8.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tldts": "7.4.18",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/aws-lambda": "8.10.164",
    "@types/node": "26.6.5",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "aws-cdk": "2.1145.0",
    "esbuild": "0.28.2",
    "prettier": "^3.9.9",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "@narada/core": "workspace:*",
    "@narada/contracts": "workspace:*",
    "@narada/runtime-aws": "workspace:*",
    "@narada/mcp": "workspace:*",
    "@narada/http-api": "workspace:*"
  },
  "license": "Apache-2.0"
}
